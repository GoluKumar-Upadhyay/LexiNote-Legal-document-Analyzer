APP_NAME=LexiNote API
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=26214400
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_PROVIDER_PRIORITY=gemini,xai,openrouter,groq,heuristic
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=24576

# Gemini direct key or Vertex config
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_AI_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# xAI / Grok
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Optional providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=LexiNote
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Optional OCR and media
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_SLIDE_SECONDS=3.5
